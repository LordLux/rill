{
  "name": "nativeyoutube-sidecar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless InnerTube sidecar: session, tolerant renderer parser, NDJSON RPC.",
  "scripts": {
    "build": "bun build --compile --outfile dist/sidecar src/main.ts",
    "capture": "bun run src/capture.ts",
    "capture:viewer-state": "bun run src/capture-viewer-state.ts",
    "export-contract-corpus": "bun run src/export-contract-corpus.ts",
    "probe": "bun run src/probe-playback.ts",
    "test": "bun test",
    "test:network": "RUN_NETWORK_TESTS=1 bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "tsc --noEmit && eslint . && bun test"
  },
  "dependencies": {
    "youtubei.js": "^18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/bun": "^1.1.0",
    "eslint": "^9.14.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.13.0"
  },
  "engines": {
    "bun": ">=1.1"
  }
}
